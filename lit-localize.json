{
  "$schema": "https://raw.githubusercontent.com/lit/lit/main/packages/localize-tools/config.schema.json",
  "sourceLocale": "en",
  "targetLocales": ["id"],
  "inputFiles": {
    "include": ["src/**/*.ts"]
  },
  "output": {
    "mode": "localeFiles",
    "outputDir": "./src/generated/locales",
    "localeFilesModule": "js"
  },
  "interchange": {
    "format": "xliff",
    "xliffDir": "./src/locales/"
  }
}
