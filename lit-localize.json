{
  "$schema": "https://raw.githubusercontent.com/lit/lit/main/packages/localize-tools/config.schema.json",
  "sourceLocale": "en",
  "targetLocales": ["id"],
  "inputFiles": {
    "include": ["src/**/*.ts"]
  },
  "output": {
    "mode": "xliff",
    "outputDir": "./src/locales/xliff"
  },
  "interchange": {
    "xliff": {
      "generate": {
        "sourceLocale": "en",
        "targetLocale": "id"
      }
    }
  }
}
